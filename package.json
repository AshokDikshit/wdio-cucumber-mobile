{
  "name": "wdio-cucumber-mobile",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "wdio": "wdio run ./wdio.conf.ts",
    "test:mobile-web": "wdio run ./wdio.mobile-web.conf.ts",
    "test:mobile-web:android-emulator": "wdio run ./wdio.mobile-web.conf.ts --capabilities 0",
    "test:mobile-web:android-device": "wdio run ./wdio.mobile-web.conf.ts --capabilities 1",
    "test:mobile-web:ios-simulator": "wdio run ./wdio.mobile-web.conf.ts --capabilities 2",
    "test:mobile-web:ios-device": "wdio run ./wdio.mobile-web.conf.ts --capabilities 3",
    "test:mobile-native": "wdio run ./wdio.mobile-native.bs.conf.ts",
    "test:mobile-native:android-emulator": "wdio run ./wdio.mobile-native.conf.ts --spec ./tests/features/**/*.feature --capabilities 0",
    "test:mobile-native:android-device": "wdio run ./wdio.mobile-native.conf.ts --spec ./tests/features/**/*.feature --capabilities 1",
    "test:mobile-native:ios-simulator": "wdio run ./wdio.mobile-native.conf.ts --spec ./tests/features/**/*.feature --capabilities 2",
    "test:mobile-native:ios-device": "wdio run ./wdio.mobile-native.conf.ts --spec ./tests/features/**/*.feature --capabilities 3",
    "report": "node generate-cucumber-report.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@wdio/appium-service": "^9.27.0",
    "@wdio/cli": "^9.27.0",
    "@wdio/cucumber-framework": "^9.27.0",
    "@wdio/globals": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "@wdio/visual-service": "^9.2.1",
    "appium-chromedriver": "^8.2.24",
    "appium-uiautomator2-driver": "^7.1.0",
    "chromedriver": "^135.0.0",
    "expect-webdriverio": "^5.6.5",
    "js-yaml": "^4.1.1",
    "multiple-cucumber-html-reporter": "^3.7.0"
  },
  "dependencies": {
    "@wdio/browserstack-service": "^9.27.0"
  }
}
