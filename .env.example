# Mobile Web Testing Environment Variables
BASE_URL=https://www.saucedemo.com

# Android Device Configuration
ANDROID_UDID=your_android_device_udid_here

# iOS Device Configuration
IOS_UDID=your_ios_device_udid_here
XCODE_ORG_ID=your_xcode_org_id_here
XCODE_SIGNING_ID=your_xcode_signing_id_here

# Mobile Native App Testing Environment Variables
# Android App Configuration
ANDROID_APP_PATH=./apps/android/app-debug.apk
ANDROID_APP_PACKAGE=com.example.app
ANDROID_APP_ACTIVITY=.MainActivity

# iOS App Configuration
IOS_APP_PATH=./apps/ios/YourApp.app
IOS_BUNDLE_ID=com.example.app
WDA_BUNDLE_ID=com.example.WebDriverAgentRunner

# Appium Server Configuration
APPIUM_HOST=localhost
APPIUM_PORT=4723